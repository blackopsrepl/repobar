#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_CONFIG="$(mktemp -t repobar-release-check-XXXXXX.json)"
TMP_STATE="$(mktemp -d -t repobar-release-check-state-XXXXXX)"

cleanup() {
  if [ -f "$TMP_STATE/daemon.lock" ]; then
    pid="$(cat "$TMP_STATE/daemon.lock" 2>/dev/null || true)"
    if [ -n "${pid:-}" ]; then
      kill "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$TMP_CONFIG"
  rm -rf "$TMP_STATE"
}

run_step() {
  echo
  echo "==> $1"
  shift
  "$@"
}

# qmllint warns on anything it cannot resolve, and it can only resolve the
# Quickshell ShellRoot type when Quickshell is installed. With no usable import
# paths it emits thousands of unresolvable-import warnings and exits non-zero on
# a clean panel, so its verdict is only meaningful when the imports resolve.
# Skip loudly in that case; fail hard on any real error.
qml_lint_present() {
  command -v qmllint >/dev/null 2>&1
}

run_qml_lint_check() {
  if ! qml_lint_present; then
    echo "qmllint not installed; skipping QML lint"
    return 0
  fi

  local output
  local status
  set +e
  output="$(qmllint frontend/quickshell/shell.qml 2>&1)"
  status=$?
  set -e

  if grep -q "Warnings occurred while importing\|Failed to import\|Failed to find the following builtins" <<<"$output"; then
    echo "qmllint cannot resolve the Quickshell/QtQuick imports here (not a panel defect); skipping QML lint."
    echo "Install Quickshell and run 'make lint' for a conclusive panel lint."
    return 0
  fi

  if [[ "$status" -ne 0 ]]; then
    echo "$output"
    echo "qmllint rejected frontend/quickshell/shell.qml" >&2
    return "$status"
  fi
}

run_archive_import_check() {
  local archive_dir
  local db_path
  archive_dir="$(mktemp -d)"
  db_path="$archive_dir/archive.sqlite"
  mkdir -p "$archive_dir/tables/repositories"
  printf '{"tables":[{"name":"repositories","files":["tables/repositories/000001.jsonl"],"columns":["full_name","stars"]}]}\n' > "$archive_dir/manifest.json"
  printf '{"full_name":"blackopsrepl/repobar","stars":1}\n' > "$archive_dir/tables/repositories/000001.jsonl"
  bin/repobar archives add smoke --config "$TMP_CONFIG" --repo "$archive_dir" --db "$db_path" --json >/dev/null
  bin/repobar archives update smoke --config "$TMP_CONFIG" --json >/dev/null
  test "$(sqlite3 "$db_path" "select stars from repositories where full_name = 'blackopsrepl/repobar';")" = "1"
  rm -rf "$archive_dir"
}

set_config_state_dir() {
  local config_path="$1"
  local state_dir="$2"
  ruby -rjson -e '
    path = ARGV.fetch(0)
    state_dir = ARGV.fetch(1)
    config = JSON.parse(File.read(path))
    config["runtime"] ||= {}
    config["runtime"]["stateDir"] = state_dir
    File.write(path, "#{JSON.pretty_generate(config)}\n")
  ' "$config_path" "$state_dir"
}

trap cleanup EXIT

cd "$ROOT_DIR"

run_step "ruby syntax" zsh -lc 'ruby -wc bin/repobar $(rg --files lib test)'
run_step "test suite" ruby -Itest test/run.rb
run_step "qml lint" run_qml_lint_check
run_step "config init" bash -lc "bin/repobar config init --config '$TMP_CONFIG' --format json >/dev/null"
set_config_state_dir "$TMP_CONFIG" "$TMP_STATE"
run_step "config validate" bin/repobar config validate --config "$TMP_CONFIG"
run_step "config rejects removed provider command" bash -lc "! bin/repobar provider github --config '$TMP_CONFIG' 2>/dev/null"
run_step "waybar render" bash -lc "bin/repobar waybar render --config '$TMP_CONFIG' >/dev/null"
run_step "ui status" bash -lc "bin/repobar ui status --config '$TMP_CONFIG' --format json --pretty >/dev/null"
run_step "ui triage mode" bash -lc "bin/repobar ui mode triage --config '$TMP_CONFIG' >/dev/null; bin/repobar ui mode overview --config '$TMP_CONFIG' >/dev/null"
run_step "settings surface" bash -lc "bin/repobar settings set repo-limit 4 --config '$TMP_CONFIG' >/dev/null; bin/repobar settings show --config '$TMP_CONFIG' --json >/dev/null"
run_step "repo filters" bash -lc "bin/repobar repos --config '$TMP_CONFIG' --scope pinned --limit 2 >/dev/null; bin/repobar repos --config '$TMP_CONFIG' --filter work --limit 2 >/dev/null; bin/repobar settings set show-contribution-header false --config '$TMP_CONFIG' >/dev/null; bin/repobar settings set heatmap-span 12m --config '$TMP_CONFIG' >/dev/null"
run_step "repo search" bash -lc "bin/repobar search repobar --config '$TMP_CONFIG' --json | ruby -rjson -e 'state = JSON.parse(STDIN.read); exit(state[\"status\"] == \"loading\" && state[\"query\"] == \"repobar\" ? 0 : 1)'"
run_step "cache surface" bash -lc "bin/repobar cache status --config '$TMP_CONFIG' --json >/dev/null; bin/repobar rate-limits --config '$TMP_CONFIG' --json >/dev/null"
run_step "archive import" run_archive_import_check

if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  run_step "auth status" bin/repobar auth status --config "$TMP_CONFIG"
  run_step "live refresh" bash -lc "bin/repobar refresh --config '$TMP_CONFIG' >/dev/null; bin/repobar repos --config '$TMP_CONFIG' --limit 3 >/dev/null"
  run_step "live recent lists" bash -lc "bin/repobar pulls blackopsrepl/repobar --config '$TMP_CONFIG' --limit 2 >/dev/null || true; bin/repobar commits blackopsrepl/repobar --config '$TMP_CONFIG' --limit 2 >/dev/null || true"
  run_step "triage projection" bash -lc "ruby -rjson -e '
    snapshot = JSON.parse(File.read(ARGV.fetch(0)))
    triage = snapshot.dig(\"view\", \"triage\")
    raise \"no triage projection\" unless triage
    %w[total pullCount issueCount flaggedCount staleCount repos items].each do |key|
      raise \"triage missing #{key}\" unless triage.key?(key)
    end
    triage.fetch(\"items\").each do |item|
      %w[id kind attention bucket bucketLabel signals action repo].each do |key|
        raise \"item missing #{key}\" unless item.key?(key)
      end
    end
    puts \"triage: #{triage[\"total\"]} items, #{triage[\"flaggedCount\"]} flagged\"
  ' \"$TMP_STATE/snapshot.json\""
else
  echo
  echo "==> live GitHub steps skipped (gh is not authenticated)"
fi

if command -v quickshell >/dev/null 2>&1; then
  echo
  echo "==> quickshell load"
  set +e
  env \
    QT_QPA_PLATFORM=wayland \
    REPOBAR_BIN="$ROOT_DIR/bin/repobar" \
    REPOBAR_CONFIG="$TMP_CONFIG" \
    REPOBAR_STATE_DIR="$TMP_STATE" \
    timeout 8s quickshell --path "$ROOT_DIR/frontend/quickshell/shell.qml" >/dev/null
  status=$?
  set -e
  if [[ "$status" -ne 0 && "$status" -ne 124 ]]; then
    echo "QuickShell load failed with exit code $status" >&2
    exit "$status"
  fi
fi

echo
echo "release-check passed"
